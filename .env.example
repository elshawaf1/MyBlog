# Public site URL (used for RSS/sitemap/canonical links)
NEXT_PUBLIC_SITE_URL=https://elshawaf1.github.io/MyBlog/

# Local vault content source (Markdown files). CI overwrites with the
# private MyVault checkout when VAULT_TOKEN secret is set.
VAULT_CONTENT_DIR=content/seed

# Vault UI defaults (owner/repo/branch of the private notes repo)
NEXT_PUBLIC_VAULT_OWNER=elshawaf1
NEXT_PUBLIC_VAULT_REPO=MyVault
NEXT_PUBLIC_VAULT_BRANCH=main
